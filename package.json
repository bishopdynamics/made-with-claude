{
  "name": "hephaestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "node scripts/astro.mjs build && node scripts/check-site.mjs",
    "preview": "node scripts/serve.mjs preview",
    "typecheck": "node scripts/astro.mjs check",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs tests/*.test.ts",
    "privacy:check": "node scripts/privacy-check.mjs --all",
    "privacy:staged": "node scripts/privacy-check.mjs --staged",
    "check": "npm run format:check && npm run typecheck && npm test && npm run privacy:check && npm run build"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@expressive-code/plugin-line-numbers": "0.44.2",
    "@secretlint/core": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "22.20.1",
    "astro": "7.3.1",
    "astro-expressive-code": "0.44.2",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "shiki": "4.4.3",
    "typescript": "6.0.3"
  }
}
