---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Seo from '../components/Seo.astro';
import VisitCounter from '../components/VisitCounter.astro';
import { resolveCanonical, siteOrigin } from '../lib/site-url.ts';
import '../styles/global.css';
import '../styles/prose.css';
import '../styles/code.css';

interface PageOptions {
  title?: string;
  description?: string;
  canonical?: string | URL;
  noindex?: boolean;
  image?: { src: string | URL; alt: string };
  prose?: boolean;
  variant?: 'standard' | 'home';
}

interface Props extends PageOptions {
  frontmatter?: PageOptions;
}

// Markdown supplies frontmatter; direct Astro props take precedence.
const options = { ...Astro.props.frontmatter, ...Astro.props };
const canonical = resolveCanonical(
  options.canonical,
  Astro.site ?? siteOrigin,
  Astro.url.pathname,
);
const { prose = Boolean(Astro.props.frontmatter), variant = 'standard' } =
  options;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo
      title={options.title}
      description={options.description}
      canonical={canonical}
      noindex={options.noindex}
      image={options.image}
    />
    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main
      id="main-content"
      class:list={[
        'site-main',
        'container',
        { 'page-home': variant === 'home' },
      ]}
      tabindex="-1"
    >
      <div class:list={['page-content', { prose }]}><slot /></div>
    </main>
    <SiteFooter />
    <VisitCounter canonical={canonical} />
  </body>
</html>
