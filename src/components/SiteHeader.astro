---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const home = path === '/';
const projects = path === '/projects' || path.startsWith('/projects/');
---

<header class="site-header">
  <nav class="container" aria-label="Main navigation">
    <a class="wordmark" href="/" aria-current={home ? 'page' : undefined}>
      <span class="wordmark-icon" aria-hidden="true">/</span>
      <span>madewithclaude<span class="wordmark-domain">.com</span></span>
    </a>
    <a
      class="nav-link"
      href="/projects/"
      aria-current={projects
        ? path === '/projects'
          ? 'page'
          : 'true'
        : undefined}>Projects</a
    >
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    min-height: 5.5rem;
    padding-block: 0.75rem;
    font-size: 0.875rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-muted);
    text-decoration: none;
  }
  .wordmark {
    gap: 0.75rem;
    color: var(--color-heading);
    font-weight: 550;
    letter-spacing: -0.025em;
  }
  .wordmark-icon {
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 450;
  }
  .wordmark-domain {
    color: var(--color-muted);
    font-weight: 400;
  }
  .nav-link {
    padding-inline: 0.75rem;
    border-radius: var(--radius);
  }
  .nav-link[aria-current] {
    background: var(--color-surface);
    color: var(--color-heading);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.45em;
  }
  nav a:hover {
    color: var(--color-accent);
  }
  @media (max-width: 30rem) {
    nav {
      min-height: 4.75rem;
      gap: 0.25rem 0.5rem;
      font-size: 0.8125rem;
    }
    .wordmark {
      gap: 0.5rem;
    }
    .nav-link {
      padding-inline: 0.5rem;
    }
  }
</style>
